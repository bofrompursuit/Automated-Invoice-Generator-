# Basic auth for the whole app — required, the app refuses all requests without it.
# Pick your own values; this is what gates access once the app is publicly deployed.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Stripe (https://dashboard.stripe.com/apikeys) — used by /api/create-checkout-session
# Use sk_test_... while developing. Only use sk_live_... once you're ready for real charges.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Canonical site URL used for Stripe redirect URLs (never trust client Origin header for this)
SITE_URL=http://localhost:3000
