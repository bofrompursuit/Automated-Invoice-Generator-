# Basic auth for the whole app — required, the app refuses all requests without it.
# Pick your own values; this is what gates access once the app is publicly deployed.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Microsoft Graph — used by /api/send-invoice, sends real email as your own
# Outlook/Live/Hotmail account (no domain verification needed, since you're
# sending through your own mailbox, not spoofing a domain).
#
# One-time setup:
# 1. https://portal.azure.com -> Microsoft Entra ID -> App registrations -> New registration
#    - Supported account types: "Accounts in any organizational directory and personal
#      Microsoft accounts (e.g. Skype, Xbox)"
#    - Redirect URI (Web): <SITE_URL>/api/auth/microsoft/callback
# 2. API permissions -> Add a permission -> Microsoft Graph -> Delegated -> Mail.Send
# 3. Certificates & secrets -> New client secret -> copy the VALUE (shown once)
# 4. Fill in MICROSOFT_CLIENT_ID / MICROSOFT_CLIENT_SECRET below, start the app, then
#    visit /api/auth/microsoft/login (while logged into the Basic Auth gate), sign in,
#    and copy the refresh token shown into MICROSOFT_REFRESH_TOKEN below.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REFRESH_TOKEN=

# Stripe (https://dashboard.stripe.com/apikeys) — used by /api/create-checkout-session
# Use sk_test_... while developing. Only use sk_live_... once you're ready for real charges.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Canonical site URL used for Stripe redirect URLs (never trust client Origin header for this)
SITE_URL=http://localhost:3000
